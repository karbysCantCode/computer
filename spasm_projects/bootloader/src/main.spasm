@include "register.spasm"
@include "conditioncodes.spasm"
@include "pseudoinstructions.spasm"
@include "jump.spasm"

@define ROM_START_ADDRESS 0x04000000
@define BOOT_PROGRAM_RAM_DESTINATION 0x00001000 ; right on top of page hardware

__start:
std_init_all_registers

; trashes: r1, r2, r3, mol
; invalidate every line of Cache
movi  r2, 50           ; tag is 11 bits, therefore 2048 cache lines
cache_init_loop:
invalichclina mo         ; inval line r1 of Icache set A
invalichclinb mo         ; inval line r1 of Icache set b
invaldchclina mo         ; inval line r1 of Dcache set A
invaldchclinb mo         ; inval line r1 of Dcache set b
adi   r1, r1, 1          ; increment counter
shli  4, r3, r1          ; extended shifting with r3 lowbyte
mov   mol, r3            ; increment 
cmp   r2, r1              
brcis c_lo, [($$$cache_init_loop)/2] ; branch if r1 < r2


copy_to_ram:
@define bootLength [bootend - boot + 2]
movi r1, bootLength    ; should be less than 65535
mov r2, r0
copy_to_ram.loop:
mvptrtmo boot + ROM_START_ADDRESS  ; move boot to MO
lear2 r3, r2
mvptrtmo BOOT_PROGRAM_RAM_DESTINATION
stear2 r3, r2
adi r2, r2, 2
cmp r1,r2
brcis c_lo, [$$$copy_to_ram.loop/2] ; branch if r2 < r1

switch_to_ram_execution:
@define RAISE_FLAG_INSTRUCTION_USE_RAM 0b0001000000000000
mov r1, sreg1
ori r1, r1, RAISE_FLAG_INSTRUCTION_USE_RAM
mov sreg1, r1
nop
jmp boot


boot:

.org 0x2000
add r1, r1, r1

bootend:
